NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/campus_connect
SESSION_SECRET=replace-with-at-least-32-random-characters
UPLOAD_DIR=./uploads
ADMIN_EMAIL=admin@college.test
ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Optional demo faculty/student accounts: set a strong password before npm run seed.
DEMO_PASSWORD=
TRUST_PROXY=0

# Required by Docker Compose; use a random alphanumeric password.
MONGO_PASSWORD=replace-with-a-long-random-alphanumeric-password

# Production only: actual DNS hostname for the HTTPS proxy.
# DOMAIN=your-portal.your-domain.example
