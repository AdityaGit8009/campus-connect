{
  "name": "campus-connect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Role-based college portal with Express, MongoDB and Bootstrap",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node --check src/app.js && node --check public/app.js",
    "postinstall": "node scripts/vendor.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "connect-mongo": "^5.1.0",
    "mongoose": "^8.19.1",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "multer": "^2.0.2",
    "zod": "^4.1.12",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4",
    "mongodb-memory-server": "^10.2.1"
  }
}
